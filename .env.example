# ShinyBella - Variables de entorno
# Copia este archivo a .env.local y llena los valores

# Supabase (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Stripe (https://stripe.com) - Modo TEST
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tu-clave-publicable
STRIPE_SECRET_KEY=sk_test_tu-clave-secreta
STRIPE_WEBHOOK_SECRET=whsec_tu-webhook-secret-cuenta
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_tu-webhook-secret-cuentas-conectadas
STRIPE_PRICE_ID_BASICO=price_tu-price-id-del-plan-basico

# Resend (emails transaccionales)
RESEND_API_KEY=re_tu-api-key
RESEND_FROM_EMAIL=ShinyBella <noreply@tu-dominio-verificado.com>

# Supabase (necesario para auth.admin.createUser en afiliación)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000